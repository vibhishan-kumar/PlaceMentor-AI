# ===================================================================
# PlaceMentor AI - Environment Configuration Example
# ===================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# For local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/placementor_db?schema=public"
# For SQLite local quick test:
# DATABASE_URL="file:./dev.db"

# JWT Secret for Student Authentication
JWT_SECRET=super_secret_jwt_key_placementor_ai_2025_change_in_production
JWT_EXPIRES_IN=7d

# File Upload Configuration
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads/resumes

# AI Provider Configuration
# Supported providers: "gemini" | "groq"
AI_PROVIDER=gemini

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq API Configuration (Optional alternative provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
